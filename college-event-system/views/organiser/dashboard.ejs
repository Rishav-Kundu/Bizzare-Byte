<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Organiser Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="organiser-header">
  <h1><%= event.name %> – Organiser Panel</h1>

  <a href="/organiser/logout" class="btn btn-danger"
     onclick="return confirm('Logout from organiser panel?')">
    Logout
  </a>
</div>

<div class="container organiser-container">

  <% if (msg) { %>
    <div class="note-text" style="background:#fff4e5;padding:10px;border-radius:8px;margin:0 20px 18px;"> <%= msg %> </div>
  <% } %>

  <a href="/organiser/budget" class="dashboard-card">
    <h3>Event Budget</h3>
    <p>View the budget set by admin.</p>
  </a>

  <a href="/organiser/messages" class="dashboard-card">
    <h3>Admin Messages</h3>
    <p>Read notices sent by admin.</p>
  </a>

  <a href="/organiser/notes" class="dashboard-card">
    <h3>Post Notes</h3>
    <p>Write notes for admin and other organisers.</p>
  </a>

  <a href="/organiser/upload-feedback" class="dashboard-card">
    <h3>Upload Feedback Form</h3>
    <p>Add the feedback form URL for this event.</p>
  </a>

  <a href="/organiser/feedback-links" class="dashboard-card">
    <h3>Current Feedback Links</h3>
    <p>Review or remove the saved feedback links.</p>
  </a>

</div>

</body>
</html>
